{
  "name": "todo-sidebar",
  "version": "1.0.0",
  "description": "Floating To-Do Widget for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.todo.sidebar",
    "productName": "TodoFloat",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "**/*",
      "!node_modules/.cache"
    ]
  },
  "portable": {
    "artifactName": "TodoFloat.exe"
  }
}